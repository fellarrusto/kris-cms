# Nella cartella dei file caricati non deve girare codice, mai.
php_flag engine off
<IfModule mod_php.c>
    php_admin_flag engine off
</IfModule>
<FilesMatch "\.(php|phtml|php[0-9]|phar|cgi|pl|py|sh|htaccess)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
AddType text/plain .php .phtml .phar
